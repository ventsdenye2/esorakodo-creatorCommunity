# Public browser-safe Supabase values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Used to construct confirmation redirects outside localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional and server-only. The M0/M1 application does not require this key.
SUPABASE_SERVICE_ROLE_KEY=

# M6 private R2. Server-only. CORS must allow your exact site origin, PUT,
# Content-Type and If-None-Match. Keep the bucket private (no r2.dev domain).
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_FORCE_PATH_STYLE=true
