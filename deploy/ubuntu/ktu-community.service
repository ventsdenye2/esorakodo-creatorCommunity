[Unit]
Description=KTU Community Node HTTP service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ktu
Group=ktu
WorkingDirectory=/srv/ktu-community/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
EnvironmentFile=/etc/ktu-community/ktu-community.env
ExecStart=/usr/bin/node /srv/ktu-community/current/dist/standalone/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
